# ============================================================
# Curfee Organic Market — Backend Environment Variables
# Copy this file to .env and fill in your real values
# ============================================================

# Server
PORT=5000
NODE_ENV=production

# MongoDB
MONGO_URI=mongodb://localhost:27017/curfee
# or use MongoDB Atlas: mongodb+srv://<user>:<pass>@cluster.mongodb.net/curfee

# JWT
JWT_SECRET=your_very_secret_jwt_key_change_this

# ── RAZORPAY ─────────────────────────────────────────────────
# Get from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX

# ── RAZORPAY ROUTE (Automatic Split Payments) ───────────────
# Create Linked Accounts in Razorpay Dashboard → Route → Linked Accounts
# Each linked account needs a verified bank account to receive funds

# Seller's Razorpay Linked Account ID (gets 70% of each order)
SELLER_ACCOUNT_ID=acc_XXXXXXXXXXXXXXXX

# Delivery Partner's Razorpay Linked Account ID (gets 20% of each order)
DELIVERY_ACCOUNT_ID=acc_XXXXXXXXXXXXXXXX

# ── SPLIT PERCENTAGES (must add up to 100) ──────────────────
# 10% stays in your platform account automatically
SELLER_SPLIT_PCT=70
DELIVERY_SPLIT_PCT=20
# Platform keeps: 100 - SELLER_SPLIT_PCT - DELIVERY_SPLIT_PCT = 10%

# ── STRIPE (optional alternative) ───────────────────────────
STRIPE_SECRET_KEY=sk_live_XXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_PUBLISHABLE_KEY=pk_live_XXXXXXXXXXXXXXXXXXXXXXXX

# ── HOW TO SET UP RAZORPAY ROUTE ────────────────────────────
# 1. Login to dashboard.razorpay.com
# 2. Go to Route → Linked Accounts → Create Account
# 3. Enter seller's/delivery partner's bank details and KYC
# 4. After approval, copy the Account ID (starts with acc_)
# 5. Paste above in SELLER_ACCOUNT_ID / DELIVERY_ACCOUNT_ID
# 6. Transfers happen automatically when an order is created!
